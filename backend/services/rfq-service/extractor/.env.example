RFQ_MINIO_ENDPOINT_URL=http://minio:9000
RFQ_MINIO_ACCESS_KEY=minioadmin
RFQ_MINIO_SECRET_KEY=minioadmin
RFQ_MINIO_BUCKET=rfq-emails
RFQ_MINIO_SECURE=false

RFQ_NATS_URL=nats://nats:4222
RFQ_NATS_CONSUMER_STREAM=RFQ_EXTRACT
RFQ_NATS_CONSUMER_SUBJECT=rfq.extract.requests
RFQ_NATS_CONSUMER_DURABLE=rfq-extractor
RFQ_NATS_CONSUMER_MAX_DELIVER=5
RFQ_NATS_STREAM=RFQ_PARTS
RFQ_NATS_SUBJECT=rfq.parts.extracted

RFQ_OPENAI_API_KEY=sk-...
RFQ_OPENAI_MODEL=gpt-5.4-nano
# Optional: override the OpenAI API base URL (e.g. for a local proxy)
# RFQ_OPENAI_BASE_URL=https://api.openai.com/v1

# Device for the GLiNER anonymizer: "cpu" or "cuda"
RFQ_GLINER_DEVICE=cpu
