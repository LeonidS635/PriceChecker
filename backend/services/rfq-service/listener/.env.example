RFQ_ALLOWED_DOMAINS=@example-a.com:1,@example-b.com:2,@example-c.com:3

RFQ_MINIO_ENDPOINT_URL=http://minio:9000
RFQ_MINIO_ACCESS_KEY=minioadmin
RFQ_MINIO_SECRET_KEY=minioadmin
RFQ_MINIO_BUCKET=rfq-emails
RFQ_MINIO_SECURE=false

RFQ_NATS_URL=nats://nats:4222
RFQ_NATS_STREAM=RFQ_EXTRACT
RFQ_NATS_SUBJECT=rfq.extract.requests

RFQ_IMAP_HOST=imap.hostinger.com
RFQ_IMAP_PORT=993
RFQ_IMAP_USE_SSL=true
RFQ_IMAP_USERNAME=your-mailbox@example.com
RFQ_IMAP_PASSWORD=your-imap-password
RFQ_IMAP_MAILBOXES=INBOX,Domain-A,Domain-B
RFQ_IMAP_STATE_PATH=/data/imap_state.json

RFQ_POLL_INTERVAL_SECONDS=300
